{
  "name": "demo-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.18",
    "expo": "~58.0.11",
    "expo-app-intents": "~0.5.7",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-device-hub": "^0.15.3",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.3",
    "expo-hinge": "~58.0.1",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.20",
    "expo-splash-screen": "~58.0.9",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "expo-widgets": "58.0.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint",
    "export": "expo export --platform all",
    "duo": "sh scripts/duo-hinge.sh",
    "android:build-time": "sh scripts/android-build-time.sh"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "@expo/ui",
          "expo-hinge"
        ]
      }
    },
    "install": {
      "exclude": [
        "expo-widgets"
      ]
    }
  }
}
